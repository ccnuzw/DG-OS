{
  "name": "dgos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run deps:check && npm run skills:check && npm run design:check && tsc && vite build",
    "deps:check": "node scripts/react-version.mjs",
    "skills:check": "node scripts/skills-catalog.mjs",
    "design:check": "node scripts/design-check.mjs",
    "design:prune": "node scripts/design-check.mjs --prune",
    "skills:catalog": "node scripts/skills-catalog.mjs --write",
    "contracts:check": "node scripts/check-host-contracts.mjs",
    "smoke:tauri": "npm run build && cargo test -p dgos --features webview-smoke --test webview_smoke --test webview_smoke_real --test webview_smoke_call --test webview_smoke_modules --test webview_smoke_appearance --test webview_smoke_appearance_host --test webview_smoke_provider_stream -- --nocapture",
    "smoke:tauri:ui": "npm run build && cargo test -p dgos --features webview-smoke --test webview_smoke_ui -- --nocapture",
    "docs:check": "node scripts/docs-tools.mjs check",
    "docs:browser": "node scripts/docs-tools.mjs browser",
    "docs:browser:check": "node scripts/docs-tools.mjs verify",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run release:build --",
    "release:build": "node scripts/release-build.mjs build",
    "release:verify": "node scripts/release-build.mjs verify",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.22.0",
    "tailwind-merge": "3.7.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "10.13.0",
    "jsdom": "^30.1.3",
    "stylelint": "17.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
