{
  "name": "dgos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run skills:check && tsc && vite build",
    "skills:check": "node scripts/skills-catalog.mjs",
    "skills:catalog": "node scripts/skills-catalog.mjs --write",
    "contracts:check": "node scripts/check-host-contracts.mjs",
    "smoke:tauri": "npm run build && cargo test -p dgos --features webview-smoke --test webview_smoke -- --nocapture",
    "docs:check": "node scripts/docs-tools.mjs check",
    "docs:browser": "node scripts/docs-tools.mjs browser",
    "docs:browser:check": "node scripts/docs-tools.mjs verify",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.22.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
