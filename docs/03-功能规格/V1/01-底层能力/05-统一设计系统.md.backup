## 7. 技术设计

### 7.1 CSS Variables 主题系统

```css
/* packages/ui/src/theme.css */

:root {
  /* 亮色主题 */
  --color-primary: #3b82f6;
  --color-secondary: #8b5cf6;
  --color-accent: #06b6d4;
  
  --color-success: #10b981;
  --color-warning: #f59e0b;
  --color-error: #ef4444;
  --color-info: #3b82f6;
  
  --color-background: #ffffff;
  --color-foreground: #0f172a;
  --color-muted: #64748b;
  --color-border: #e2e8f0;
  
  --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --font-mono: "SF Mono", Monaco, "Cascadia Code", monospace;
  
  --spacing-unit: 4px;
  
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-full: 9999px;
  
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  
  --transition-fast: 150ms;
  --transition-normal: 300ms;
  --transition-slow: 500ms;
}

:root[data-theme="dark"] {
  /* 暗色主题 */
  --color-primary: #60a5fa;
  --color-secondary: #a78bfa;
  --color-accent: #22d3ee;
  
  --color-success: #34d399;
  --color-warning: #fbbf24;
  --color-error: #f87171;
  --color-info: #60a5fa;
  
  --color-background: #0f172a;
  --color-foreground: #f1f5f9;
  --color-muted: #94a3b8;
  --color-border: #334155;
}
```

### 7.2 主题切换实现

```typescript
// packages/ui/src/ThemeProvider.tsx

import React, { createContext, useContext, useEffect, useState } from 'react';
import { invoke } from '@tauri-apps/api';

type Theme = 'light' | 'dark';

interface ThemeContextType {
  theme: Theme;
  setTheme: (theme: Theme) => void;
  toggleTheme: () => void;
}

const ThemeContext = createContext<ThemeContextType | undefined>(undefined);

export const ThemeProvider: React.FC<{
  children: React.ReactNode;
  defaultTheme?: Theme;
}> = ({ children, defaultTheme = 'light' }) => {
  const [theme, setThemeState] = useState<Theme>(defaultTheme);
  
  // B05-01: 初始化时从数据库加载用户主题偏好
  useEffect(() => {
    invoke<Theme>('get_user_theme').then((savedTheme) => {
      setThemeState(savedTheme);
      applyTheme(savedTheme);
    });
  }, []);
  
  // B05-02: 应用主题到 DOM
  const applyTheme = (newTheme: Theme) => {
    document.documentElement.setAttribute('data-theme', newTheme);
  };
  
  // B05-03: 设置主题
  const setTheme = (newTheme: Theme) => {
    setThemeState(newTheme);
    applyTheme(newTheme);
    
    // B05-04: 保存到数据库
    invoke('save_user_theme', { theme: newTheme });
  };
  
  // B05-05: 切换主题
  const toggleTheme = () => {
    const newTheme = theme === 'light' ? 'dark' : 'light';
    setTheme(newTheme);
  };
  
  return (
    <ThemeContext.Provider value={{ theme, setTheme, toggleTheme }}>
      {children}
    </ThemeContext.Provider>
  );
};

export const useTheme = () => {
  const context = useContext(ThemeContext);
  if (!context) {
    throw new Error('useTheme must be used within ThemeProvider');
  }
  return context;
};
```

### 7.3 Button 组件实现

```typescript
// packages/ui/src/Button.tsx

import React from 'react';
import { cn } from './utils';

export interface ButtonProps extends React.ButtonHTMLAttributes<HTMLButtonElement> {
  variant?: 'primary' | 'secondary' | 'ghost' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  loading?: boolean;
  children: React.ReactNode;
}

// B05-06: Button 组件
export const Button: React.FC<ButtonProps> = ({
  variant = 'primary',
  size = 'md',
  loading = false,
  disabled,
  children,
  className,
  ...props
}) => {
  // B05-07: 根据 variant 生成样式类
  const variantClasses = {
    primary: 'bg-[var(--color-primary)] text-white hover:opacity-90',
    secondary: 'bg-[var(--color-secondary)] text-white hover:opacity-90',
    ghost: 'bg-transparent text-[var(--color-foreground)] hover:bg-[var(--color-muted)]',
    danger: 'bg-[var(--color-error)] text-white hover:opacity-90',
  };
  
  // B05-08: 根据 size 生成样式类
  const sizeClasses = {
    sm: 'px-3 py-1.5 text-sm',
    md: 'px-4 py-2 text-base',
    lg: 'px-6 py-3 text-lg',
  };
  
  return (
    <button
      className={cn(
        'rounded-[var(--radius-md)]',
        'transition-all duration-[var(--transition-fast)]',
        'disabled:opacity-50 disabled:cursor-not-allowed',
        variantClasses[variant],
        sizeClasses[size],
        className
      )}
      disabled={disabled || loading}
      {...props}
    >
      {loading ? (
        <span className="flex items-center gap-2">
          <LoadingSpinner />
          {children}
        </span>
      ) : (
        children
      )}
    </button>
  );
};
```

### 7.4 ESLint 强制复用规则

```javascript
// .eslintrc.js

module.exports = {
  rules: {
    // B05-09: 禁止直接使用原生 HTML 元素
    'no-restricted-syntax': [
      'error',
      {
        selector: 'JSXElement[openingElement.name.name="button"]',
        message: '禁止直接使用 <button>，请使用 <Button> 组件',
      },
      {
        selector: 'JSXElement[openingElement.name.name="input"]',
        message: '禁止直接使用 <input>，请使用 <Input> 组件',
      },
      {
        selector: 'JSXElement[openingElement.name.name="select"]',
        message: '禁止直接使用 <select>，请使用 <Select> 组件',
      },
      // ... 其他元素
    ],
  },
};
```

